{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheScreenShot",
  "version": "0.1.0",
  "identifier": "com.thescreenshot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TheScreenShot",
        "width": 760,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "resizable": false,
        "width": 800,
        "height": 600,
        "title": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
